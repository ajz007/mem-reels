# Local mode supplies a deterministic developer identity. Use `google` only after
# registering the Memory Reels callback in Google Cloud Console.
VITE_APP_ENV=local
AUTH_MODE=local
GOOGLE_CLIENT_ID=replace-with-memory-reels-client-id
GOOGLE_CLIENT_SECRET=replace-with-local-secret-never-commit
GOOGLE_REDIRECT_URL=http://127.0.0.1:8787/api/auth/google/callback
# Server-only future S3 configuration. Do not add credentials to this file.
AWS_REGION=replace-with-region
MEMORY_REELS_S3_BUCKET=replace-with-private-bucket-name
# Server-only. Never use a VITE_ prefix for provider credentials.
FAL_KEY=replace-with-server-only-key
# Keep false until the exact request and US$0.35 maximum have been reviewed.
FAL_LIVE_SUBMISSION_ENABLED=false
